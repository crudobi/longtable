<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only: trust user-installed CAs so e2e tests can fetch from a
         local HTTPS fixture server using a test CA. Merged into debug builds
         only; release builds are unaffected (default: system CAs). -->
    <application android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
